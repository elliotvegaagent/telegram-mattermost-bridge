MM_URL=https://mattermost.example.com
MM_BOT_TOKEN=replace_me
MM_CHANNEL_ID=replace_me

TG_BOT_TOKEN=replace_me
TG_CHAT_ID=-1001234567890

# Multiple pairs replace MM_CHANNEL_ID and TG_CHAT_ID:
# Add "mm_to_tg_author_mode":"hidden" to anonymize Mattermost authors in Telegram for one pair.
# BRIDGE_PAIRS=[{"id":"default","tg_chat_id":-1001234567890,"mm_channel_id":"channel_id"}]

DB_PATH=/data/bridge.db
HTTP_BIND=0.0.0.0:8080
LOG_LEVEL=INFO
MAX_ATTACHMENT_BYTES=26214400
